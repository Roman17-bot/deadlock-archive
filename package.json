{
  "name": "deadlock-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "predev": "node scripts/export-mechanics.mjs && node scripts/prepare-public.mjs",
    "dev": "node scripts/dev.mjs",
    "predev:web": "node scripts/export-mechanics.mjs && node scripts/prepare-public.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "dotnet watch --project backend/Deadlock.Api run --no-launch-profile -- serve",
    "build": "tsc --noEmit && node scripts/export-mechanics.mjs && node scripts/prepare-public.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:check": "node scripts/validate-data.mjs",
    "data:update": "node scripts/update-data.mjs",
    "items:refresh": "node scripts/update-items.mjs",
    "db:setup": "node scripts/database/cli.mjs setup",
    "db:migrate": "node scripts/database/cli.mjs migrate",
    "db:import": "node scripts/database/cli.mjs import",
    "db:status": "node scripts/database/cli.mjs status",
    "db:export": "node scripts/database/cli.mjs export",
    "db:backup": "node scripts/database/cli.mjs backup",
    "db:query": "node scripts/database/cli.mjs query",
    "db:test": "node scripts/test-database.mjs",
    "db:sync": "node scripts/sync-data.mjs",
    "data:verify-publication": "node scripts/verify-public-snapshot.mjs",
    "knowledge": "node scripts/knowledge/cli.mjs",
    "knowledge:import": "node scripts/knowledge/cli.mjs import",
    "skill:install": "node scripts/install-skill.mjs",
    "team": "node scripts/agents/cli.mjs",
    "team:init": "node scripts/agents/cli.mjs init",
    "team:install": "node scripts/agents/cli.mjs install",
    "design:install": "node scripts/install-design-skills.mjs",
    "design:check": "node scripts/design/check-skills.mjs",
    "design:discovery": "python -B scripts/design/check-discovery.py",
    "design:test": "python -B -m unittest discover -s scripts/design -p \"*_test.py\"",
    "design:mcp:check": "python -B scripts/design/mcp_probe.py",
    "backend:build": "dotnet build backend/Deadlock.Api --nologo",
    "backend:test": "dotnet test backend/Deadlock.Tests --nologo"
  },
  "dependencies": {
    "i18next": "26.5.10",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
