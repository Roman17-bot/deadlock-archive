# Copy only if you already have an application role and database.
# Normally run `npm run db:setup`; it creates ignored .env.local for you.
# Keep real credentials out of this tracked example and VS Code settings.
DEADLOCK_DB_HOST=127.0.0.1
DEADLOCK_DB_PORT=5432
DEADLOCK_DB_NAME=deadlock_archive
DEADLOCK_DB_TEST_NAME=deadlock_archive_test
DEADLOCK_DB_USER=deadlock_archive_app
DEADLOCK_DB_PASSWORD=replace-with-local-application-password
